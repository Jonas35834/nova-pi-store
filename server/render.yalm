services:

  - type: web

    name: nova-pi-store-api

    runtime: python

    rootDir: server

    buildCommand: pip install -r requirements.txt

    startCommand: gunicorn --workers 1 --threads 100 app:app

    envVars:

      - key: FIREBASE_SERVICE_ACCOUNT_FILE

        value: /etc/secrets/firebase-service-account.json

      - key: PYTHON_VERSION

        value: 3.12.10
