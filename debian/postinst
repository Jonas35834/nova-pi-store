#!/bin/sh

set -e

echo "======================================"
echo "Nova Pi Store Installer"
echo "======================================"
echo


# ============================================================
# Benutzer erstellen
# ============================================================

if ! id nova-store >/dev/null 2>&1; then

    echo "[1/7] Erstelle Benutzer nova-store..."

    useradd \
        --system \
        --home /opt/nova-pi-store \
        --shell /usr/sbin/nologin \
        nova-store

else

    echo "[1/7] Benutzer nova-store existiert bereits."

fi


# ============================================================
# Anwendung installieren
# ============================================================

echo "[2/7] Installiere Nova Pi Store..."

mkdir -p \
    /opt/nova-pi-store


rm -rf \
    /opt/nova-pi-store/app


cp -r \
    /usr/share/nova-pi-store/app \
    /opt/nova-pi-store/


chown -R \
    nova-store:nova-store \
    /opt/nova-pi-store


# ============================================================
# Install-Wrapper
# ============================================================

echo "[3/7] Erstelle Installations-Wrapper..."

cat > /usr/local/bin/nova-pi-store-install <<'EOF'
#!/bin/sh

set -e

if [ "$#" -eq 0 ]; then
    echo "Keine Pakete angegeben."
    exit 1
fi

for package in "$@"; do

    case "$package" in

        ''|*[!a-zA-Z0-9.+_-]*)
            echo "Ungültiger Paketname: $package"
            exit 1
            ;;

    esac

done

echo "Installiere: $*"
echo

exec /usr/bin/apt-get install -y "$@"

EOF


chmod 755 \
    /usr/local/bin/nova-pi-store-install


# ============================================================
# Remove-Wrapper
# ============================================================

echo "[4/7] Erstelle Deinstallations-Wrapper..."

cat > /usr/local/bin/nova-pi-store-remove <<'EOF'
#!/bin/sh

set -e

if [ "$#" -eq 0 ]; then
    echo "Keine Pakete angegeben."
    exit 1
fi

for package in "$@"; do

    case "$package" in

        ''|*[!a-zA-Z0-9.+_-]*)
            echo "Ungültiger Paketname: $package"
            exit 1
            ;;

    esac

done

echo "Deinstalliere: $*"
echo

exec /usr/bin/apt-get remove -y "$@"

EOF


chmod 755 \
    /usr/local/bin/nova-pi-store-remove


# ============================================================
# Update-Wrapper
# ============================================================

echo "[5/7] Erstelle Update-Wrapper..."

cat > /usr/local/bin/nova-pi-store-update <<'EOF'
#!/bin/sh

set -e

if [ "$#" -eq 0 ]; then
    echo "Keine Pakete angegeben."
    exit 1
fi

for package in "$@"; do

    case "$package" in

        ''|*[!a-zA-Z0-9.+_-]*)
            echo "Ungültiger Paketname: $package"
            exit 1
            ;;

    esac

done

echo "Aktualisiere: $*"
echo

exec /usr/bin/apt-get install --only-upgrade -y "$@"

EOF


chmod 755 \
    /usr/local/bin/nova-pi-store-update


# ============================================================
# Sudo-Berechtigungen
# ============================================================

echo "[6/7] Konfiguriere Berechtigungen..."

cat > /etc/sudoers.d/nova-pi-store <<'EOF'
nova-store ALL=(root) NOPASSWD: /usr/local/bin/nova-pi-store-install *
nova-store ALL=(root) NOPASSWD: /usr/local/bin/nova-pi-store-remove *
nova-store ALL=(root) NOPASSWD: /usr/local/bin/nova-pi-store-update *
EOF


chmod 440 \
    /etc/sudoers.d/nova-pi-store


# Sudo-Konfiguration überprüfen

if command -v visudo >/dev/null 2>&1; then

    visudo \
        -cf /etc/sudoers.d/nova-pi-store

fi


# ============================================================
# Service starten
# ============================================================

echo "[7/7] Starte Nova Pi Store..."

systemctl daemon-reload

systemctl enable nova-pi-store.service

systemctl restart nova-pi-store.service || true


echo
echo "======================================"
echo "Nova Pi Store installation complete!"
echo "======================================"
echo
echo "Weboberfläche:"
echo "http://<RASPBERRY-PI-IP>:8080"
echo

exit 0
