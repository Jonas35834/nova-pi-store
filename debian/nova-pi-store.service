[Unit]
Description=Nova Pi Store Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=root
Group=root

WorkingDirectory=/opt/nova-pi-store

ExecStart=/usr/bin/python3 /opt/nova-pi-store/agent/agent.py

Restart=always
RestartSec=5

Environment=NOVA_PI_STORE_SERVER=https://nova-pi-store.onrender.com
Environment=NOVA_PI_STORE_POLL_INTERVAL=10

PrivateTmp=true

[Install]
WantedBy=multi-user.target
